#!/usr/bin/env bash
#
# run_onchange_after_50-os-migration.sh.tmpl
#
# Restores packages/AUR/flatpaks/services from os-migration/ — but ONLY when
# the `migrate` data flag is true (set during `chezmoi init` prompt, or with
#   chezmoi apply --promptBool migrate=true ).
#
# Because this is a `run_onchange_` script, chezmoi re-runs it whenever its
# rendered content changes. We inline hashes of every manifest below, so
# editing/regenerating any list retriggers the restore — and since restore.sh
# is fully idempotent, that only installs the *new* items.
#
# Manifest hashes (do not edit by hand — regenerated by chezmoi templating):
{{ range (list "pkglist.txt" "aurlist.txt" "flatpaks.txt" "enabled-services.txt" "user-services.txt") -}}
#   {{ . }}: {{ include (joinPath $.chezmoi.sourceDir "os-migration" .) | sha256sum }}
{{ end -}}

set -Eeuo pipefail

{{ if not (dig "migrate" false .) -}}
echo "[os-migration] migrate flag is false; skipping. Enable with: chezmoi init --promptBool migrate=true (or set [data].migrate=true)"
exit 0
{{ end -}}

MIGRATION_DIR="{{ joinPath .chezmoi.sourceDir "os-migration" }}"

if [[ ! -x "$MIGRATION_DIR/restore.sh" ]]; then
    echo "[os-migration] restore.sh not found or not executable in $MIGRATION_DIR" >&2
    exit 1
fi

echo "[os-migration] Running restore (non-interactive)..."
exec "$MIGRATION_DIR/restore.sh" --yes
