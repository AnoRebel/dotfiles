{
  "custom/myhyprv": {
    //shows the current power profile and switches to next on click
    "exec": "~/.config/hypr/hyprv_util",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "on-click": "~/.config/hypr/hyprv_util vswitch",
    "tooltip": true
  },

  "custom/light_dark": {
    "format": "󰐾",
    "on-click": "~/.config/waybar/scripts/baraction light",
    "tooltip": false
  }
}
