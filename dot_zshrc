function nvims() {
  configs=("default" "AstroNvim" "LazyVim" "NormalNvim" "NvIDE")
  config=$(printf "%s\n" "${configs[@]}" | fzf --prompt=" Neovim Config  " --height=50% --layout=reverse --border --exit-0)
  [[ -z $config ]] && echo "Nothing selected" && return 0
  [[ $config == "default" ]] && config=""
  NVIM_APPNAME=$config nvim $@
}

mdr () { pandoc $1 | lynx -stdin }

rga-fzf() {
  RG_PREFIX="rga --files-with-matches"
  local file
  file="$(FZF_DEFAULT_COMMAND="$RG_PREFIX '$1'" fzf --sort --preview="[[ ! -z {} ]] && rga --pretty --context 5 {q} {}" --phony -q "$1" --bind "change:reload:$RG_PREFIX {q}" --preview-window="70%:wrap")" &&
  echo "opening $file" && xdg-open "$file"
}

