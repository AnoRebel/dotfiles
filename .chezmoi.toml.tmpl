encryption = "age"

[data]
    # OS migration is OFF by default so no interactive prompt is required at
    # init and no "config template changed" nag appears. To rebuild a machine's
    # packages/services on a fresh box, opt in explicitly:
    #   chezmoi init --promptBool migrate=true && chezmoi apply
    migrate = {{ promptBool "migrate" false }}

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1ytyarpug0hlclnygr22f6rzsakqfs6tyzndxrnrchzyzgq65a46qg2t8a7"

[edit]
    command = "avim"
    args = ["-f"]

[diff]
    # pager = "delta -s"
    pager = "hunk diff --watch"
    # pager = "diff-so-fancy"
    # command = "meld"
    # args = ["--diff", "%destination", "%target"]

[merge]
    command = "avim"
    args = [
        "-d",
        "%destination",
        "%source",
        "%target"
    ]
